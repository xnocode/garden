// Prisma schema for the digital garden / Obsidian-publishing site.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A published note imported from the Obsidian vault.
model Note {
  /// URL-safe slug derived from the file path / title (lowercased, kebab-case).
  slug        String    @id
  /// Display title (from frontmatter `title` or first H1 / filename).
  title       String
  /// Optional short description (frontmatter `description` or first paragraph).
  description String?
  /// Markdown source with frontmatter stripped.
  content     String
  /// Pre-rendered HTML (server-side render at publish time).
  html        String
  /// Raw file contents including YAML frontmatter.
  raw         String
  /// JSON array of tag strings, e.g. ["essay","ai/alignment"].
  tags        String    @default("[]")
  /// JSON array of alias strings.
  aliases     String    @default("[]")
  /// JSON array of outgoing link targets: [{slug, original, alias, exists}].
  links       String    @default("[]")
  /// Word count of the note body.
  wordCount   Int       @default(0)
  /// Whether the source note had draft:true.
  draft       Boolean   @default(false)
  /// Note visibility level: "public", "members", or "private".
  visibility  String    @default("public")
  /// Publish date (frontmatter `date` or `publish` field).
  publishDate DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  /// Original file path relative to the vault root, e.g. "notes/ai.md".
  path        String
  /// Parent folder, e.g. "notes" (used for breadcrumbs/explorer).
  folder      String?

  @@index([folder])
  @@index([publishDate])
  @@index([visibility])
}

/// User account model for authentication and role-based access.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  /// Role: "admin" for garden owner, "member" for registered users.
  role          String    @default("member")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  comments      Comment[]
}

/// OAuth account provider link (e.g. Google).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// NextAuth database sessions.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email verification tokens / OTPs.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Native in-house comment model for note discussions.
model Comment {
  id        String    @id @default(cuid())
  content   String
  noteSlug  String
  userId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([noteSlug])
  @@index([userId])
  @@index([parentId])
}

/// Work-in-progress drafts created on web / mobile devices for cloud auto-save.
model Draft {
  id          String   @id @default(cuid())
  title       String   @default("")
  content     String   @default("")
  tags        String   @default("[]")
  visibility  String   @default("public")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


