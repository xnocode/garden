# Database URL (SQLite — relative to project root)
DATABASE_URL=file:/home/z/my-project/db/garden.db

# Google Analytics (GA4) Configuration (Option B)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=XXXXXXXXX
GA_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# Use standard \n characters for formatting the private key
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# NextAuth & Admin Configuration (100% Free)
ADMIN_EMAIL="your_actual_email@gmail.com"
NEXTAUTH_SECRET="generate-a-secure-random-32-char-secret-here"
NEXTAUTH_URL="https://gardenx.qzz.io"

# Google OAuth Credentials (100% Free via Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Fork & Copy Alert Notifications (100% Free)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="123456789"

# GitHub Webhook Secret (optional but recommended for security)
# Set this in your GitHub repo → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=""


